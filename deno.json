{
  "name": "@oxian/oxian-js",
  "version": "0.3.2",
  "license": "MIT",
  "exports": {
    ".": "./main.ts",
    "./init": "./init.ts",
    "./config": "./config.ts",
    "./api": "./api.ts",
    "./file-loader": "./file-loader.ts"
  },
  "unstable": [
    "bare-node-builtins",
    "detect-cjs",
    "node-globals",
    "unstable-sloppy-imports",
    "unsafe-proto",
    "webgpu",
    "broadcast-channel",
    "worker-options",
    "cron",
    "kv",
    "net",
    "otel"
  ],
  "tasks": {
    "start": "ENV=development deno run --unstable-* -A --env -r main.ts",
    "dev": "ENV=development WATCH=true deno run -A --env main.ts",
    "file-loader": "ENV=production deno run -A --env --reload=http://local@localhost:9000 file-loader.ts",
    "api": "ENV=production deno run -A --env --reload=http://localhost:9000 api.ts"
  },
  "lock": false
}
