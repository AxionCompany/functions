{
  "name": "@oxian/oxian-js",
  "version": "0.1.2",
  "license": "MIT",
  "exports": "./main.ts",
  "tasks": {
    "start": "DENO_DIR=./data/local/cache/.deno ENV=production deno run -A --no-lock --unstable --no-prompt --unstable-kv --unstable-sloppy-imports main.ts",
    "dev": "importmap=deno.json DENO_DIR=./data/local/cache/.deno ENV=development WATCH=true PORT=9002 deno run -A -r --no-lock --unstable --unstable-kv --unstable-sloppy-imports --unstable-worker-options main.ts",
    "file-loader": "ENV=production deno run -A --reload=http://local@localhost:9000 --no-lock --unstable --unstable-kv --unstable-sloppy-imports file-loader.ts",
    "api": "ENV=production deno run -A --reload=http://localhost:9000 --no-lock --unstable --unstable-kv --unstable-sloppy-imports api.ts"
  },
  "imports": {
    "react": "npm:react",
    "react-dom/server": "npm:react-dom/server",
    "@deno/emit": "jsr:@deno/emit@0.46.0"
  }
}
